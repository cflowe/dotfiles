[alias]
  branches = branch -a
  br = !git -P branch
  brv = branch -v
  ci = commit
  cloen = clone
  co = checkout
  h = help
  sm = submodule
  lg = log
  lgn = log --name-status
  lgp = log -p
  ahead = log @{u}..
  behind = log ..@{u}
  dff = diff
  dif = diff
  idff = diff
  cdiff = diff --cached
  cdif = diff --cached
  hist = log
  pul = pull
  pulll = pull
  puhs = push
  pus = push
  ref-sort-commit-time = "!fn(){ env TZ=UTC git for-each-ref --sort=committerdate --format=\"%(committerdate:iso-strict-local) %(refname:short) %(objectname:short)\" \"$@\" | column -t; }; fn \"$@\""
  st = status
  sw = switch

[core]
  pager = ''
;  gitproxy=default-proxy

[diff]
;  tool = meld
  submodule = log

[filter "lfs"]
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f

[init]
  defaultBranch = master

[pull]
  rebase = false
  ff = true

[push]
  default = simple

[status]
  submodulesummary = 1

[tar "tar.xz"]
  command = xz -c

[url "https://bitbucket.com/"]
  insteadOf = bbh:

[url "git@bitbucket.org:"]
  insteadOf = bbg:

[url "git@github.com:cflowe/"]
  insteadOf = cf:

[url "https://github.com/"]
  insteadOf = gh:

[url "git@github.com"]
  insteadOf = gg:

[url "https://gist.github.com/"]
  insteadOf = gist:

[tar "tar.xz"]
  command = xz -c

