root = true

[*]
#charset = utf-8
#end_of_line = lf
#end_of_line = unset
indent_size = 2
indent_style = space
insert_final_newline = true
tab_width = 2
trim_trailing_whitespace = true

[*.bats]

[*.{diff,patch}]
insert_final_newline = false
trim_trailing_whitespace = false

[*.md]
x-soft-wrap-text = true
indent_size = 4

[*.nix]

[*.py]
#charset = utf-8
indent_size = 4

[*.sh]

[*.{hcl,tf,tftpl,tfvars}]

[*.{yaml,yml}]
#charset = utf-8

[Dockerfile{,.*}]

[{GNUmakefile,Makefile,makefile,*akefile*}]
tab_width = 4
indent_style = tab
